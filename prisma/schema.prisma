generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  date      String   @unique
  weightKg  Float
  memo      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("weight_logs")
}

model Meal {
  id         Int      @id @default(autoincrement())
  date       String
  mealType   String
  foodName   String
  calories   Int
  proteinG   Float
  fatG       Float
  carbsG     Float
  memo       String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])

  @@map("meals")
}

model MealTemplate {
  id        Int    @id @default(autoincrement())
  name      String
  mealType  String
  foodName  String
  calories  Int
  proteinG  Float
  fatG      Float
  carbsG    Float
  memo      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meal_templates")
}

model Schedule {
  id         Int      @id @default(autoincrement())
  date       String
  title      String
  startTime  String
  endTime    String
  memo       String?
  categoryId Int

  category   ScheduleCategory @relation(fields: [categoryId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])

  @@map("schedules")
}

model ScheduleTemplate {
  id    Int    @id @default(autoincrement())
  name  String

  items ScheduleTemplateItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schedule_templates")
}

model ScheduleTemplateItem {
  id         Int    @id @default(autoincrement())
  templateId Int
  title      String
  startTime  String
  endTime    String
  memo       String?
  categoryId Int

  template ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category ScheduleCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])

  @@map("schedule_template_items")
}

model NutritionGoal {
  id        Int      @id @default(autoincrement())
  calories  Int
  proteinG  Float
  fatG      Float
  carbsG    Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nutrition_goals")
}

model ScheduleCategory {
  id    Int    @id @default(autoincrement())
  name  String
  color String

  schedules Schedule[]
  templateItems ScheduleTemplateItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schedule_categories")
}
